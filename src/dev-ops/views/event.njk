{% extends 'layouts/page.njk' %}

{% from "back/macro.njk" import back %}
{% from "char-count/macro.njk" import charCount %}
{% from "icon/macro.njk" import icon %}
{% from "status-badge/macro.njk" import statusBadge %}

{# Tailwind only sees class names written literally in this file. #}
{% set factLabel = "text-sm font-medium text-base-content/70" %}
{# `leading-none`: an inline mono box on the sans line otherwise makes its row a pixel taller. #}
{% set monoValue = "font-mono text-sm leading-none break-all" %}
{% set monoMuted = "font-mono text-sm leading-none text-base-content/70" %}
{# A time is short enough to keep whole; `break-all` would split it mid-number. #}
{% set monoTime = "font-mono text-sm leading-none tabular-nums whitespace-nowrap" %}
{# `select-all` so one click takes the whole id, and `break-all` so the hex
   wraps inside the column rather than widening a phone. #}
{% set idLine = "font-mono text-sm break-all text-base-content/70 select-all" %}
{# The success role is solid: `alert-soft` writes the message in the role's own
   colour on a tint of that colour, and for success that is a pale green on a
   pale green, under 3:1. #}
{% set bannerAlerts = {
  success: "alert-success",
  warning: "alert-soft alert-warning",
  error: "alert-soft alert-error"
} %}
{% set bannerIcons = {
  success: "circle-check",
  warning: "exclamation-triangle",
  error: "exclamation-circle"
} %}

{#
  Every clock on this page is already the full UK wall clock, to the
  millisecond, so there is no `title`: a tooltip could only repeat the text
  under the cursor. The instant rides in `datetime` alone, in UTC, for
  machines. An undated row keeps its text and drops that too — there is no
  instant to name, and `datetime` is what makes a `time` machine-readable.
#}
{% macro timestamp(text, instant, class, testId) %}{% if class %}<time class="{{ class }}"{% else %}<time{% endif %}{% if instant %} datetime="{{ instant }}"{% endif %}{% if testId %} data-testid="{{ testId }}"{% endif %}>{{ text }}</time>{% endmacro %}

{% macro payloadLines(json, label, testId) %}
  <div class="max-h-[30rem] w-full overflow-auto rounded-box border border-base-300 bg-base-200 py-2 font-mono text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content" tabindex="0" role="region" aria-label="{{ label }}" data-testid="{{ testId }}">
    {% for line in json.split("\n") %}<pre class="flex gap-3 px-3" data-testid="{{ testId }}-line"><span class="w-9 shrink-0 text-right tabular-nums text-base-content/30 before:content-[attr(data-line)]" data-line="{{ loop.index }}" aria-hidden="true"></span><code>{{ line }}</code></pre>{% endfor %}
  </div>
{% endmacro %}

{# D7: a value a JSON round trip would change. Shown where the payload is about to be saved, never on the read-only view. #}
{% macro plainJsonAlert(warning) %}
  {% if warning %}
    <div role="status" class="alert alert-warning alert-soft text-sm" data-testid="event-plain-json-warning">
      {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
      <span>{{ warning }}</span>
    </div>
  {% endif %}
{% endmacro %}

{% macro fact(label, testId) %}
  <div class="contents" data-testid="{{ testId }}">
    <dt class="{{ factLabel }}">{{ label }}</dt>
    <dd class="min-w-0">{{ caller() }}</dd>
  </div>
{% endmacro %}

{% block pageTitle %}{% if eventName.name %}{{ eventName.name }} {{ (eventId.slice(0, 8) ~ "…" ~ eventId.slice(-4)) if eventId | length > 16 else eventId }}{% else %}{{ pageTitle }}{% endif %} | {{ serviceName }}{% endblock %}

{% block content %}
  {{ back({ href: backHref }) }}

  {% if banner %}
    <div id="event-banner" role="alert" class="alert {{ bannerAlerts[banner.role] }} mt-3 text-sm{% if bannerFocus %} focus:outline-none" tabindex="-1" data-focus-on-arrival{% else %}"{% endif %} data-testid="event-banner">
      {{ icon({ name: bannerIcons[banner.role], class: 'size-4 shrink-0' }) }}
      <span>{{ banner.message }}</span>
    </div>
  {% endif %}

  {% if unavailable %}
    <div role="alert" class="alert alert-error alert-soft mt-3 text-sm" data-testid="event-error">
      {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
      <span>{% if timedOut %}This event could not be loaded: GAS timed out waiting for it. Refresh to try again.{% else %}This event could not be loaded from GAS.{% endif %}</span>
    </div>
    <header class="mt-3 mb-5" data-testid="event-header">
      {# Nothing came back to name the page after, so the heading falls back to
         the same word the `title` does rather than inventing a second one. #}
      <h1 class="text-xl font-semibold" data-testid="event-title">{{ pageTitle }}</h1>
      <p class="mt-1 {{ idLine }}" data-testid="event-id">{{ eventId }}</p>
    </header>
  {% else %}
    <header class="mt-2 mb-5" data-testid="event-header">
      {% if eventName.name %}
        <h1 class="text-xl font-semibold break-words" title="{{ type }}" data-testid="event-title"><span aria-hidden="true" data-testid="event-type-name">{{ eventName.name }}</span><span class="sr-only" data-testid="event-type-spoken">{{ eventName.spoken }}</span></h1>
        {# A `p`, never a heading: it names the same thing the h1 does, and a
           second heading would put two entries in the outline for one subject. #}
        <p class="mt-1 {{ idLine }}" data-testid="event-id">{{ eventId }}</p>
      {% else %}
        {# No name to head with, so the id is the heading and is not repeated. #}
        <h1 class="font-mono text-xl font-semibold break-all" data-testid="event-title">{{ eventId }}</h1>
      {% endif %}
      <p class="mt-2" data-testid="event-header-status">{{ statusBadge({ status: status, label: statusLabel, role: statusRole, retrying: statusRetrying, variant: "solid" }) }}</p>
    </header>

    <section class="card card-border mb-5 bg-base-100" data-testid="event-facts-card">
      <div class="card-body gap-3 p-5">
        <h2 class="card-title text-base" data-testid="event-facts-heading">Event</h2>
        {# Two lists, not one grid: auto-placement never goes backwards, so the right-hand facts would stack below the left. #}
        <div class="grid gap-x-6 gap-y-3 text-sm lg:grid-cols-2" data-testid="event-facts">
          <dl class="grid grid-cols-1 content-start gap-x-6 gap-y-3 sm:grid-cols-[8rem_minmax(0,1fr)]" data-testid="event-facts-common">
            {% call fact("Service", "event-fact-service") %}
              <span data-testid="event-service">{{ serviceLabel }}</span>
            {% endcall %}

            {% call fact("Queue", "event-fact-route") %}
              <span data-testid="event-box">{{ boxLabel }}</span>
            {% endcall %}

            {% call fact("Trace ID", "event-fact-trace-id") %}
              {% if traceId and traceHref %}
                <a class="link {{ monoValue }}" href="{{ traceHref }}" target="_blank" rel="noopener noreferrer" data-testid="event-trace-id">{{ traceId }}<span class="sr-only"> (opens in a new tab)</span></a>{{ icon({ name: 'external-link', class: 'inline size-3.5 align-middle opacity-50' }) }}
              {% elif traceId %}
                <span class="{{ monoValue }}" data-testid="event-trace-id">{{ traceId }}</span>
              {% else %}
                <span class="{{ monoMuted }}" data-testid="event-trace-id-none">—</span>
              {% endif %}
            {% endcall %}

            {% if expiresText %}
              {% call fact("Deletion date", "event-fact-deletion-date") %}
                {{ timestamp(expiresText, expiresInstant, monoTime, "event-deletion-date") }}
              {% endcall %}
            {% endif %}

            {% if editedFact %}
              {% call fact("Payload edited", "event-fact-edited") %}
                <div data-testid="event-edited">
                  <span data-testid="event-edited-by">by {{ editedFact.by }} on {{ timestamp(editedFact.at, editedFact.atInstant, monoTime, "event-edited-at") }}</span>
                  {% if editedFact.note %}<div class="italic text-base-content/70" data-testid="event-edited-note">"{{ editedFact.note }}"</div>{% endif %}
                </div>
              {% endcall %}
            {% endif %}

            {% if lastRedriveText %}
              {% call fact("Last redrive", "event-fact-last-redrive") %}
                <span data-testid="event-last-redrive">{{ timestamp(lastRedriveText, lastRedriveInstant, monoTime, "event-last-redrive-at") }}{% if lastRedriveBy %} <span class="text-sm text-base-content/70" data-testid="event-last-redrive-by">· by {{ lastRedriveBy }}</span>{% endif %}</span>
              {% endcall %}
            {% endif %}
          </dl>

          <dl class="grid grid-cols-1 content-start gap-x-6 gap-y-3 sm:grid-cols-[8rem_minmax(0,1fr)]" data-testid="event-facts-box">
            {% call fact("Segregation ref", "event-fact-segregation-ref") %}
              {% if segregationRef %}
                <a class="link link-hover {{ monoValue }}" href="{{ segregationRefHref }}" title="{{ segregationRefTitle }}" data-testid="event-segregation-ref">{{ segregationRef }}</a>
              {% else %}
                <span class="{{ monoMuted }}" data-testid="event-segregation-ref-none">—</span>
              {% endif %}
            {% endcall %}

            {# Inbox rows have no topic. #}
            {% if not isInbox %}
              {% call fact("Topic", "event-fact-transport") %}
                {% if targetTopic %}
                  <span class="{{ monoValue }}" data-testid="event-queue-value">{{ targetTopic }}</span>
                {% else %}
                  <span class="{{ monoMuted }}" data-testid="event-queue-value-none">—</span>
                {% endif %}
              {% endcall %}
            {% endif %}
          </dl>

          {# A row of its own across both lists: a reason, a name and an instant
             do not fit the half-width column the two lists are set in, and the
             second list has nothing to put beside it. #}
          {% if purgedFact %}
            <dl class="grid grid-cols-1 content-start gap-x-6 gap-y-3 sm:grid-cols-[8rem_minmax(0,1fr)] lg:col-span-2" data-testid="event-facts-purged">
              {% call fact(purgedFact.label, "event-fact-purged") %}
                <div data-testid="event-purged">
                  <span data-testid="event-purged-reason">{{ purgedFact.reason }}</span>
                  <span class="text-base-content/70" data-testid="event-purged-by">· by {{ purgedFact.by }} on {{ timestamp(purgedFact.at, purgedFact.atInstant, monoTime, "event-purged-at") }}</span>
                  {% if purgedFact.note %}<div class="italic text-base-content/70" data-testid="event-purged-note">"{{ purgedFact.note }}"</div>{% endif %}
                </div>
              {% endcall %}
            </dl>
          {% endif %}
        </div>
      </div>
    </section>

    <section class="card card-border mb-5 bg-base-100" data-testid="event-attempts-card">
      <div class="card-body gap-3 p-5">
        {%- set attemptIcons = { warning: "size-4 text-warning", error: "size-4 text-error [&>path:first-child]:fill-current [&>path:not(:first-child)]:stroke-base-100" } -%}
        {%- set attemptNames = { warning: "Failed", error: "Failed, final attempt" } -%}
        {# A filled shape as well as colour for the final failure (WCAG 1.4.1), in the same box as the others. #}
        {%- set attemptShapes = { warning: "circle-x", error: "octagon-x" } -%}
        <h2 class="card-title text-base" data-testid="event-attempts-heading">Attempts{% if attempts %} <span class="text-sm font-normal tabular-nums text-base-content/70" data-testid="event-attempts-value">{{ attempts.made }} of {{ attempts.allowed }}</span>{% endif %}</h2>
        {% if attemptsBlock in ["predated", "predatedCompleted"] %}
          <div class="flex flex-col gap-2 text-sm" data-testid="event-attempts-predated">
            <p class="text-base-content/70" data-testid="event-attempts-empty">No attempt details recorded (event predates attempt history).{% if lastResubmissionDate %} Last resubmitted {{ timestamp(lastResubmissionDate, lastResubmissionInstant, "", "event-predated-resubmitted-at") }}.{% endif %}</p>
            {% if attemptsBlock == "predated" and (errorName or errorMessage) %}
              <div class="flex items-start gap-1.5" data-testid="event-last-error">
                {%- set lastErrorIcons = { warning: "mt-0.5 size-4 shrink-0 text-warning", error: "mt-0.5 size-4 shrink-0 text-error [&>path:first-child]:fill-current [&>path:not(:first-child)]:stroke-base-100" } -%}
                {{ icon({ name: attemptShapes[errorRole], class: lastErrorIcons[errorRole] }) }}<span class="sr-only" data-testid="event-last-error-icon-name">{{ attemptNames[errorRole] }}</span>
                <div class="min-w-0">
                  <div class="text-base-content/70" data-testid="event-last-error-label">Last error</div>
                  <div class="font-mono wrap-anywhere" data-testid="event-error-message">{% if errorName %}<span class="font-medium" data-testid="event-error-name">{{ errorName }}</span>{% if errorMessage %}: {% endif %}{% endif %}{{ errorMessage }}</div>
                  {% if errorAt %}<div class="font-mono text-base-content/70" data-testid="event-error-at">at {{ timestamp(errorAt, errorAtInstant) }}</div>{% endif %}
                  {% if errorSearchHref %}
                    <div class="mt-1"><a class="link" href="{{ errorSearchHref }}" data-testid="event-error-search">Show all events with this error{{ icon({ name: 'arrow-right', class: 'ms-1 inline size-3.5 align-middle' }) }}</a></div>
                  {% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% endif %}
        {% if attemptsBlock in ["timeline", "predatedCompleted"] %}
          <ul class="timeline timeline-vertical timeline-compact timeline-snap-icon [&>li]:[--timeline-col-start:0]" data-testid="event-attempt-list">
            {% for attempt in attemptHistory %}
              <li data-testid="event-attempt">
                {% if not loop.first %}<hr aria-hidden="true">{% endif %}
                <div class="timeline-middle">{{ icon({ name: attemptShapes[attempt.role], class: attemptIcons[attempt.role] }) }}<span class="sr-only" data-testid="event-attempt-icon-name">{{ attemptNames[attempt.role] }}</span></div>
                <div class="timeline-end mb-3 pt-0.5">
                  <div class="font-mono text-sm tabular-nums">
                    <span class="font-medium text-base-content/70" data-testid="event-attempt-number">{{ attempt.number }}</span>
                    <span class="text-base-content/30" aria-hidden="true">·</span>
                    {{ timestamp(attempt.precise, attempt.instant, "", "event-attempt-when") }}
                    {% if attempt.delta %}
                      <span class="text-base-content/30" aria-hidden="true">·</span>
                      <span class="text-base-content/70" data-testid="event-attempt-delta">{{ attempt.delta }}</span>
                    {% endif %}
                  </div>
                  {%- if attempt.stack -%}
                    <details class="group" data-testid="event-attempt-details">
                      <summary class="flex cursor-pointer items-start gap-1 rounded-sm font-mono text-sm wrap-anywhere [list-style:none] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content [&::-webkit-details-marker]:hidden" title="{{ attempt.name }}: {{ attempt.message }}" data-testid="event-attempt-error"><span><span class="font-medium" data-testid="event-attempt-name">{{ attempt.name }}</span>: {{ attempt.message }}</span>{{ icon({ name: 'chevron-down', class: 'mt-0.5 size-4 shrink-0 text-base-content/70 transition-transform group-open:rotate-180' }) }}<span class="sr-only">stacktrace</span></summary>
                      <div class="mt-1 max-w-full overflow-x-auto">
                        <pre class="font-mono text-sm whitespace-pre-wrap text-base-content/70" data-testid="event-attempt-stack">{{ attempt.stack }}</pre>
                      </div>
                    </details>
                  {%- else -%}
                    <div class="font-mono text-sm wrap-anywhere" title="{{ attempt.name }}: {{ attempt.message }}" data-testid="event-attempt-error"><span class="font-medium" data-testid="event-attempt-name">{{ attempt.name }}</span>: {{ attempt.message }}</div>
                  {%- endif -%}
                  {# `?error=` matches `lastError.message` exactly, so only the last attempt links. #}
                  {% if loop.last and errorSearchHref %}
                    <div class="mt-1"><a class="link text-sm" href="{{ errorSearchHref }}" data-testid="event-error-search">Show all events with this error{{ icon({ name: 'arrow-right', class: 'ms-1 inline size-3.5 align-middle' }) }}</a></div>
                  {% endif %}
                </div>
                {% if not loop.last or attemptSuccess %}<hr aria-hidden="true">{% endif %}
              </li>
            {% endfor %}
            {% if attemptSuccess %}
              <li data-testid="event-attempt-success">
                {% if attemptHistory | length %}<hr aria-hidden="true">{% endif %}
                <div class="timeline-middle">{{ icon({ name: 'circle-check', class: 'size-4 text-success' }) }}<span class="sr-only" data-testid="event-attempt-icon-name">Succeeded</span></div>
                <div class="timeline-end mb-3 pt-0.5">
                  <div class="font-mono text-sm tabular-nums">
                    <span class="font-medium text-base-content/70" data-testid="event-attempt-success-number">{{ attemptSuccess.number }}</span>
                    <span class="text-base-content/30" aria-hidden="true">·</span>
                    {% if attemptSuccess.precise %}
                      {{ timestamp(attemptSuccess.precise, attemptSuccess.instant, "", "event-attempt-success-when") }}
                    {% else %}
                      <span class="text-base-content/70" data-testid="event-attempt-success-when">completion time not recorded</span>
                    {% endif %}
                    {% if attemptSuccess.delta %}
                      <span class="text-base-content/30" aria-hidden="true">·</span>
                      <span class="text-base-content/70" data-testid="event-attempt-success-delta">{{ attemptSuccess.delta }}</span>
                    {% endif %}
                  </div>
                </div>
              </li>
            {% endif %}
          </ul>
          {% if resubmittedSinceLastAttempt %}
            <p class="text-sm text-base-content/70" data-testid="event-resubmitted">Last resubmitted {{ timestamp(lastResubmissionDate, lastResubmissionInstant, "", "event-resubmitted-at") }} — nothing recorded since.</p>
          {% endif %}
        {% elif attemptsBlock == "redriven" %}
          <div class="flex flex-col gap-2 text-sm" data-testid="event-redriven">
            <p class="text-base-content/70" data-testid="event-redriven-label">Redriven {{ timestamp(lastRedriveText, lastRedriveInstant, "font-mono tabular-nums") }}{% if lastRedriveBy %} by {{ lastRedriveBy }}{% endif %} — no attempts since.</p>
            {% if errorName or errorMessage %}
              <div class="flex items-start gap-1.5" data-testid="event-last-error">
                {{ icon({ name: 'circle-x', class: 'mt-0.5 size-4 shrink-0 text-warning' }) }}<span class="sr-only" data-testid="event-last-error-icon-name">Failed</span>
                <div class="min-w-0">
                  <div class="text-base-content/70" data-testid="event-last-error-label">Last error before redrive</div>
                  <div class="font-mono wrap-anywhere" data-testid="event-error-message">{% if errorName %}<span class="font-medium" data-testid="event-error-name">{{ errorName }}</span>{% if errorMessage %}: {% endif %}{% endif %}{{ errorMessage }}</div>
                  {% if errorAt %}<div class="font-mono text-base-content/70" data-testid="event-error-at">at {{ timestamp(errorAt, errorAtInstant) }}</div>{% endif %}
                </div>
              </div>
            {% endif %}
          </div>
        {% elif attemptsBlock == "notYet" %}
          <p class="text-sm text-base-content/70" data-testid="event-attempts-empty">No attempts recorded yet.</p>
        {% endif %}
        {% if noAttemptsSinceEdit %}
          <p class="text-sm text-base-content/70" data-testid="event-no-attempts-since-edit">No attempts since the payload was edited.</p>
        {% endif %}
      </div>
    </section>

    <section id="payload" class="card card-border scroll-mt-4 bg-base-100" data-testid="event-payload-card">
      <div class="card-body gap-3 p-5">
        {% set editing = payloadEditor or payloadReview %}
        <div class="{{ "flex min-h-10 flex-wrap items-center justify-between gap-2" if canRedrive or canPurge or canEdit else "flex flex-wrap items-center justify-between gap-2" }}">
          {# One heading for the card, renamed for the step it is on. The review's takes focus, so arriving there says where you are. #}
          <h2 id="payload-heading" class="card-title text-base focus:outline-none" tabindex="-1"{% if payloadReview and not payloadReview.error %} data-focus-on-arrival{% endif %} data-testid="event-payload-heading">{% if payloadEditor %}Edit payload{% elif payloadReview %}Review your changes{% else %}Payload{% endif %}</h2>
          {# No way in while one of them is under way: the panel below is the question. #}
          {% if not confirmRedrive and not purgeConfirm and not editing %}
            <div class="flex flex-wrap items-center gap-2" data-testid="event-payload-actions">
              {% if canEdit %}
                <a id="edit" class="btn btn-outline scroll-mt-4" href="{{ editHref }}#payload" data-testid="event-edit">Edit<span class="sr-only"> payload</span></a>
              {% endif %}
              {% if canPurge %}
                <a id="purge" class="btn btn-outline scroll-mt-4" href="{{ purgeHref }}#payload" data-testid="event-purge">Purge</a>
              {% endif %}
              {% if canRedrive %}
                <a id="redrive" class="btn btn-error scroll-mt-4" href="{{ redriveHref }}#payload" data-testid="event-redrive">Redrive</a>
              {% endif %}
            </div>
          {% elif editing %}
            {# Unseen, but holding the row at the height the buttons gave it, so the editor's lines sit where the payload's did even where the buttons wrap. #}
            <div class="invisible flex flex-wrap items-center gap-2" aria-hidden="true" data-testid="event-payload-actions-placeholder">
              {% if canEdit %}<span class="btn btn-outline">Edit</span>{% endif %}
              {% if canPurge %}<span class="btn btn-outline">Purge</span>{% endif %}
              {% if canRedrive %}<span class="btn btn-error">Redrive</span>{% endif %}
            </div>
          {% endif %}
        </div>

        {% if futileWarning and not confirmRedrive and not editing %}
          <div role="note" class="alert alert-warning text-sm" data-testid="event-futile-warning">
            {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
            <span>{{ futileWarning }}</span>
          </div>
        {% endif %}

        {% if confirmRedrive %}
          <section class="flex flex-col gap-3 rounded-box border border-base-300 p-4" aria-labelledby="redrive-question" aria-describedby="{{ "redrive-futile redrive-explain" if futileWarning else "redrive-explain" }}" data-testid="event-redrive-confirm">
            {% if futileWarning %}
              <div id="redrive-futile" role="note" class="alert alert-warning text-sm" data-testid="event-futile-warning">
                {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
                <span>{{ futileWarning }}</span>
              </div>
            {% endif %}
            <h3 id="redrive-question" class="text-sm font-semibold focus:outline-none" tabindex="-1" data-focus-on-arrival data-testid="event-redrive-heading">Redrive this event?</h3>
            <p id="redrive-explain" class="text-sm" data-testid="event-redrive-question">The poller will retry it up to its attempt limit. {% if redrivePurgedNote %}<span data-testid="event-redrive-purged">{{ redrivePurgedNote }}</span> {% endif %}{% if redriveEditedNote %}<span data-testid="event-redrive-edited">{{ redriveEditedNote }}</span> {% endif %}This action is audited.</p>
            <div class="flex items-center gap-2">
              <form method="post" action="{{ redriveAction }}" data-testid="event-redrive-form">
                <input type="hidden" name="from" value="{{ from }}" data-testid="event-redrive-from">
                <button class="btn btn-error" type="submit"{% if futileWarning %} aria-describedby="redrive-futile"{% endif %} data-testid="event-redrive-submit">Confirm redrive</button>
              </form>
              <a class="btn btn-ghost" href="{{ cancelHref }}#redrive" data-testid="event-redrive-cancel">Cancel</a>
            </div>
          </section>
        {% endif %}

        {% if purgeConfirm %}
          {# The alert takes focus where there is one: only ever one `data-focus-on-arrival` on the page. #}
          <section class="flex flex-col gap-3 rounded-box border border-base-300 p-4" aria-labelledby="purge-question" aria-describedby="purge-explain" data-testid="event-purge-confirm">
            <h3 id="purge-question" class="text-sm font-semibold focus:outline-none" tabindex="-1"{% if not purgeConfirm.error %} data-focus-on-arrival{% endif %} data-testid="event-purge-heading">Purge this event?</h3>
            <p id="purge-explain" class="text-sm" data-testid="event-purge-question">It won't be processed or retried, and it leaves the dead-letter list. It will be deleted on {{ timestamp(purgeConfirm.deletionText, purgeConfirm.deletionInstant, "font-medium tabular-nums", "event-purge-deletion-date") }}. You can redrive it until then. This action is audited.</p>

            <form class="flex flex-col gap-3" method="post" action="{{ purgeAction }}" data-testid="event-purge-form">
              <input type="hidden" name="from" value="{{ from }}" data-testid="event-purge-from">

              {% if purgeConfirm.error %}
                {# daisyUI has no error summary; with one possible error this is one alert and one link. #}
                <div role="alert" class="alert alert-error alert-soft text-sm focus:outline-none" tabindex="-1" data-focus-on-arrival data-testid="event-purge-error">
                  {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
                  <span><span class="font-semibold">Couldn't purge.</span> <a class="link" href="{{ purgeConfirm.error.href }}" data-testid="event-purge-error-link">{{ purgeConfirm.error.message }}</a></span>
                </div>
              {% endif %}

              <fieldset class="fieldset gap-1 py-0"{% if purgeConfirm.reasonMessage %} aria-describedby="{{ purgeConfirm.reasonDescribedBy }}"{% endif %} data-testid="event-purge-reasons">
                <legend class="fieldset-legend text-sm" data-testid="event-purge-reasons-legend">Reason</legend>
                {% if purgeConfirm.reasonMessage %}
                  <p class="text-sm text-error" id="{{ purgeConfirm.reasonDescribedBy }}" data-testid="event-purge-reasons-message">{{ purgeConfirm.reasonMessage }}</p>
                {% endif %}
                {% for reason in purgeConfirm.reasons %}
                  <label class="label cursor-pointer justify-start gap-2 text-sm text-base-content" data-testid="event-purge-reason">
                    <input class="radio radio-sm" type="radio" id="{{ reason.id }}" name="reasonCode" value="{{ reason.value }}"{% if reason.checked %} checked{% endif %} data-testid="event-purge-reason-input">
                    <span data-testid="event-purge-reason-label">{{ reason.label }}</span>
                  </label>
                {% endfor %}
              </fieldset>

              {# One control, so a real `label`: the textarea is named "Note" rather than its placeholder, and the badge stays outside the name. #}
              <div class="fieldset gap-1 py-0" data-testid="event-purge-note">
                <div class="flex items-center gap-2" data-testid="event-purge-note-legend">
                  <label class="fieldset-legend me-0 text-sm" for="purge-note" data-testid="event-purge-note-label">Note</label>
                  <span class="badge badge-ghost badge-sm" data-testid="event-purge-note-badge">Required for Other</span>
                </div>
                {{ charCount({
                  id: "purge-note",
                  name: "note",
                  value: purgeConfirm.note,
                  count: purgeConfirm.noteCount,
                  max: purgeConfirm.noteMax,
                  message: purgeConfirm.noteMessage,
                  messageId: "purge-note-hint",
                  helpId: "purge-note-help",
                  describedBy: purgeConfirm.noteDescribedBy,
                  hint: "Don't include personal data.",
                  placeholder: "Why will this event never be processed?",
                  testId: "event-purge-note-field"
                }) }}
              </div>

              <div class="flex items-center gap-2">
                <button class="btn btn-neutral" type="submit" data-testid="event-purge-submit">Confirm purge</button>
                <a class="btn btn-ghost" href="{{ cancelHref }}#purge" data-testid="event-purge-cancel">Cancel</a>
              </div>
            </form>
          </section>
        {% endif %}

        {% if payloadEditor %}
          <do-payload-editor class="flex flex-col gap-3" data-step="edit" data-testid="event-payload-editor">
            {{ plainJsonAlert(plainJsonWarning) }}

            {% if payloadEditor.alert %}
              {# The one thing to read on arrival, so it takes focus; the textarea does otherwise. #}
              <div role="{{ "alert" if payloadEditor.alert.role == "error" else "status" }}" class="alert {{ "alert-error alert-soft" if payloadEditor.alert.role == "error" }} text-sm focus:outline-none" tabindex="-1" data-focus-on-arrival data-testid="event-payload-editor-alert">
                {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
                <span><span class="font-semibold">{{ payloadEditor.alert.lead }}</span> {{ payloadEditor.alert.message }}{% if payloadEditor.alert.line %} <a class="link" href="#payload-text" data-payload-editor-go-to data-line="{{ payloadEditor.alert.line }}" data-column="{{ payloadEditor.alert.column }}" data-testid="event-payload-editor-go-to">Go to line {{ payloadEditor.alert.line }}</a>{% endif %}</span>
              </div>
            {% endif %}

            <form class="flex flex-col gap-3" method="post" action="{{ reviewAction }}" data-testid="event-payload-editor-form">
              <input type="hidden" name="from" value="{{ from }}" data-testid="event-payload-editor-from">
              <input type="hidden" name="revision" value="{{ payloadEditor.revision }}" data-testid="event-payload-editor-revision">
              {# The gutter is drawn by the element, which keeps it level with the text as it scrolls; without it there is no gutter to fall out of step. #}
              {# daisyUI's own pattern for a field with more than the control in it: the component class on the parent, which takes the focus outline and the `validator` colours, and a bare textarea inside.
                 `p-0` and the gutter's `w-12` put each number and each line exactly where the read-only payload has them. #}
              <div class="textarea validator flex max-h-[30rem] w-full overflow-hidden p-0" data-testid="event-payload-editor-frame">
                <div class="w-12 shrink-0 overflow-hidden py-2 text-right font-mono text-sm leading-5 tabular-nums text-base-content/50 select-none [&>[data-error]]:font-semibold [&>[data-error]]:text-error" aria-hidden="true" hidden data-payload-editor-gutter data-testid="event-payload-editor-gutter"></div>
                {# The line break after the tag is the one the parser drops, so a text that starts with one keeps it. #}
                <textarea id="payload-text" class="min-h-40 w-full resize-y overflow-auto px-3 py-2 font-mono text-sm leading-5 whitespace-pre" name="text" rows="{{ payloadEditor.rows }}" wrap="off" spellcheck="false" autocapitalize="off" autocomplete="off" aria-labelledby="payload-heading"{% if payloadEditor.alert and payloadEditor.alert.role == "error" %} aria-invalid="true"{% endif %}{% if not payloadEditor.alert %} data-focus-on-arrival{% endif %} data-payload-editor-text data-testid="event-payload-editor-text">
{{ payloadEditor.text }}</textarea>
              </div>
              <div class="flex items-center gap-2">
                <button class="btn btn-neutral" type="submit" data-payload-editor-review data-testid="event-payload-editor-review">Review changes</button>
                <a class="btn btn-ghost" href="{{ cancelHref }}#payload" data-payload-editor-discard data-testid="event-payload-editor-discard">Discard<span class="sr-only"> changes</span></a>
              </div>
            </form>

            {% if payloadEditor.currentJson %}
              <details class="collapse collapse-arrow border border-base-300" open data-testid="event-payload-current">
                <summary class="collapse-title text-sm font-semibold" data-testid="event-payload-current-summary">The payload as it is now</summary>
                <div class="collapse-content">
                  {{ payloadLines(payloadEditor.currentJson, "The payload as it is now", "event-payload-current-lines") }}
                </div>
              </details>
            {% endif %}
          </do-payload-editor>
        {% elif payloadReview %}
          <do-payload-editor class="flex flex-col gap-3" data-step="review" data-testid="event-payload-review">
            {{ plainJsonAlert(plainJsonWarning) }}

            {% if payloadReview.numberWarning %}
              <div role="status" class="alert alert-warning alert-soft text-sm" data-testid="event-payload-number-warning">
                {{ icon({ name: 'exclamation-triangle', class: 'size-4 shrink-0' }) }}
                <span>{{ payloadReview.numberWarning }}</span>
              </div>
            {% endif %}

            {% if payloadReview.diff.tooLong %}
              <p class="text-sm text-base-content/70" data-testid="event-payload-diff-too-long">Too many changes to show; the whole payload is below.</p>
            {% else %}
              {# Colour and a sign for each changed line, and words for a screen reader, which is told neither. #}
              <div class="max-h-[30rem] w-full overflow-auto rounded-box border border-base-300 bg-base-200 py-2 font-mono text-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-base-content" tabindex="0" role="region" aria-label="What changed" data-testid="event-payload-diff">
                {% for row in payloadReview.diff.rows %}
                  {% if row.op == "skipped" %}
                    <pre class="flex gap-3 bg-base-300/50 px-3 text-base-content/70 italic" data-testid="event-payload-diff-skipped"><span class="w-9 shrink-0" aria-hidden="true"></span><span class="w-9 shrink-0" aria-hidden="true"></span><span class="w-3 shrink-0" aria-hidden="true"></span><code>{{ row.text }}</code></pre>
                  {% elif row.op == "removed" %}
                    <pre class="flex gap-3 bg-error/15 px-3" data-testid="event-payload-diff-removed"><span class="w-9 shrink-0 text-right tabular-nums text-base-content/50" aria-hidden="true">{{ row.a }}</span><span class="w-9 shrink-0" aria-hidden="true"></span><span class="w-3 shrink-0 font-bold text-error" aria-hidden="true">−</span><code><span class="sr-only">Removed line {{ row.a }}: </span>{{ row.text }}</code></pre>
                  {% elif row.op == "added" %}
                    <pre class="flex gap-3 bg-success/15 px-3" data-testid="event-payload-diff-added"><span class="w-9 shrink-0" aria-hidden="true"></span><span class="w-9 shrink-0 text-right tabular-nums text-base-content/50" aria-hidden="true">{{ row.b }}</span><span class="w-3 shrink-0 font-bold text-success" aria-hidden="true">+</span><code><span class="sr-only">Added line {{ row.b }}: </span>{{ row.text }}</code></pre>
                  {% else %}
                    <pre class="flex gap-3 px-3" data-testid="event-payload-diff-same"><span class="w-9 shrink-0 text-right tabular-nums text-base-content/50" aria-hidden="true">{{ row.a }}</span><span class="w-9 shrink-0 text-right tabular-nums text-base-content/50" aria-hidden="true">{{ row.b }}</span><span class="w-3 shrink-0" aria-hidden="true"></span><code>{{ row.text }}</code></pre>
                  {% endif %}
                {% endfor %}
              </div>
            {% endif %}

            <details class="collapse collapse-arrow border border-base-300"{% if payloadReview.diff.tooLong %} open{% endif %} data-testid="event-payload-to-save">
              <summary class="collapse-title text-sm font-semibold" data-testid="event-payload-to-save-summary">Show the payload you're about to save</summary>
              <div class="collapse-content">
                {{ payloadLines(payloadReview.text, "The payload you're about to save", "event-payload-to-save-lines") }}
              </div>
            </details>

            <section class="flex flex-col gap-3 rounded-box border border-base-300 p-4" aria-labelledby="edit-question" aria-describedby="edit-explain" data-testid="event-edit-confirm">
              <h3 id="edit-question" class="text-sm font-semibold" data-testid="event-edit-heading">Save these changes?</h3>
              <p id="edit-explain" class="text-sm" data-testid="event-edit-question">{{ payloadReview.confirmBody }}</p>

              <form class="flex flex-col gap-3" method="post" action="{{ saveAction }}" data-testid="event-edit-form">
                <input type="hidden" name="from" value="{{ from }}" data-testid="event-edit-from">
                <input type="hidden" name="revision" value="{{ payloadReview.revision }}" data-testid="event-edit-revision">
                {# The formatted text rides the page body, never a url or the session; the save reads it again. #}
                <input type="hidden" name="text" value="{{ payloadReview.text }}" data-testid="event-edit-text">

                {% if payloadReview.error %}
                  <div role="alert" class="alert alert-error alert-soft text-sm focus:outline-none" tabindex="-1" data-focus-on-arrival data-testid="event-edit-error">
                    {{ icon({ name: 'exclamation-circle', class: 'size-4 shrink-0' }) }}
                    <span><span class="font-semibold">Couldn't save.</span> <a class="link" href="{{ payloadReview.error.href }}" data-testid="event-edit-error-link">{{ payloadReview.error.message }}</a></span>
                  </div>
                {% endif %}

                <div class="fieldset gap-1 py-0" data-testid="event-edit-note">
                  <div class="flex items-center gap-2" data-testid="event-edit-note-legend">
                    <label class="fieldset-legend me-0 text-sm" for="edit-note" data-testid="event-edit-note-label">Why are you changing it?</label>
                    <span class="badge badge-ghost badge-sm" data-testid="event-edit-note-badge">Required</span>
                  </div>
                  {{ charCount({
                    id: "edit-note",
                    name: "note",
                    value: payloadReview.note,
                    count: payloadReview.noteCount,
                    max: payloadReview.noteMax,
                    message: payloadReview.noteMessage,
                    messageId: "edit-note-hint",
                    helpId: "edit-note-help",
                    describedBy: payloadReview.noteDescribedBy,
                    hint: "",
                    placeholder: "What was wrong, and why is this the right fix?",
                    testId: "event-edit-note-field"
                  }) }}
                </div>

                <div class="flex items-center gap-2">
                  <button class="btn btn-neutral" type="submit" data-testid="event-edit-submit">Confirm save</button>
                  <button class="btn btn-ghost" type="submit" formaction="{{ reviewAction }}" name="back" value="edit" data-payload-editor-back data-testid="event-edit-back">Back to editing</button>
                </div>
              </form>
            </section>
          </do-payload-editor>
        {% else %}
          {% if payloadJson %}
            {{ payloadLines(payloadJson, "Payload", "event-payload") }}
          {% else %}
            <p class="py-6 text-center text-sm text-base-content/70" data-testid="event-payload-empty">This event carries no payload.</p>
          {% endif %}

          {% if originalPayloadJson %}
            <details class="collapse collapse-arrow border border-base-300" data-testid="event-original-payload">
              <summary class="collapse-title text-sm font-semibold" data-testid="event-original-payload-summary">Payload before the first edit</summary>
              <div class="collapse-content">
                {{ payloadLines(originalPayloadJson, "Payload before the first edit", "event-original-payload-lines") }}
              </div>
            </details>
          {% endif %}
        {% endif %}
      </div>
    </section>

  {% endif %}
{% endblock %}
