{%- from "../../core/macros.njk" import attrs, cls -%}
{%- set id = p.id or gpaId('gpa-pop') -%}
  <gpa-popover{% if p.align %} data-align="{{ p.align }}"{% endif %}><div class="gpa-dropdown">
    <button type="button" class="{{ p.triggerClasses or 'gpa-btn gpa-btn-default gpa-btn-md' }}" popovertarget="{{ id }}" aria-haspopup="dialog"{% if p.triggerTestId %} data-testid="{{ p.triggerTestId }}"{% endif %}>{{ p.trigger | safe }}</button>
    <div popover id="{{ id }}" role="dialog" aria-label="{{ p.label or p.title }}" tabindex="-1" class="{{ cls('gpa-float gpa-popover' ~ (' gpa-popover-padded' if p.padded !== false else ''), p) }}"{{ attrs(p) }}>
      {%- if p.title %}<div class="gpa-popover-head"><span class="heading-xs">{{ p.title }}</span></div>{% endif -%}
      {{ caller() }}
    </div>
  </div></gpa-popover>
