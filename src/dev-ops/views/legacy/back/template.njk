{% from "muted/macro.njk" import muted -%}
{% from "icon/macro.njk" import icon %}

{# The trail is gone, but its landmark is not: one link is still navigation, and
   a named `nav` keeps it in the landmark list a screen reader can jump between. #}
{%- set prefix = params.testId | default("event", true) -%}
<nav class="text-sm" aria-label="{{ params.navLabel | default("Events list", true) }}" data-testid="{{ prefix }}-back-nav">
  <do-back>
    <a class="link link-hover inline-flex items-center gap-1 {{ muted }} hover:text-base-content" href="{{ params.href }}" data-testid="{{ prefix }}-back">
      {{ icon({ name: 'arrow-right', class: 'size-4 rotate-180' }) }}
      <span>{{ params.label or ("Back to " ~ (params.list | default("events", true))) }}</span>
    </a>
  </do-back>
</nav>
