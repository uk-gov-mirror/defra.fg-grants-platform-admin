{
  "name": "fg-grants-platform-admin",
  "version": "0.0.0",
  "description": "CDP Frontend Template",
  "sideEffects": [
    "./src/dev-ops/client/focus-on-arrival.ts"
  ],
  "main": "src/main.ts",
  "type": "module",
  "imports": {
    "#test/*": "./test/*"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:frontend": "vite build",
    "dev": "AWS_EMF_ENVIRONMENT=Local npm run server:watch",
    "dev:debug": "AWS_EMF_ENVIRONMENT=Local npm run server:debug",
    "docker:dev": "npm run dev",
    "format": "prettier --write \"src/**/*.ts\" \"**/*.{ts,cjs,md,json,config.ts,test.ts}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"**/*.{ts,cjs,md,json,config.ts,test.ts}\"",
    "git:pre-commit-hook": "npm run security-audit && npm run format:check && npm run typecheck && npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "lint": "run-s lint:js lint:scss",
    "lint:js": "eslint .",
    "lint:js:fix": "eslint . --fix",
    "lint:scss": "stylelint \"src/**/*.scss\" --cache --cache-location .cache/stylelint --cache-strategy content --color --ignore-path .gitignore",
    "test": "AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest run --coverage",
    "test:watch": "AWS_EMF_ENVIRONMENT=Local TZ=UTC vitest",
    "security-audit": "npm audit --audit-level=critical",
    "server:watch": "nodemon --exec node --inspect=0.0.0.0 --ext ts,json --legacy-watch --watch ./src --env-file-if-exists=.env ./src/main.ts",
    "server:debug": "nodemon --exec node --inspect-brk=0.0.0.0 --ext ts,json --legacy-watch --watch ./src --env-file-if-exists=.env ./src/main.ts",
    "prestart": "npm run build:frontend",
    "start": "NODE_ENV=production node .",
    "setup:husky": "node -e \"try { (await import('husky')).default() } catch (e) { if (e.code !== 'ERR_MODULE_NOT_FOUND') throw e }\" --input-type module"
  },
  "overrides": {
    "ts-api-utils": "3.0.0-rc.1"
  },
  "author": "Defra DDTS",
  "license": "OGL-UK-3.0",
  "dependencies": {
    "@defra/cdp-auditing": "0.6.1",
    "@defra/cdp-metrics": "0.6.0",
    "@defra/hapi-auth-oidc": "0.5.5",
    "@defra/hapi-secure-context": "0.4.0",
    "@defra/hapi-tracing": "1.30.0",
    "@elastic/ecs-pino-format": "1.5.0",
    "@hapi/boom": "10.0.1",
    "@hapi/bourne": "3.0.0",
    "@hapi/catbox-memory": "6.0.2",
    "@hapi/catbox-redis": "7.0.2",
    "@hapi/hapi": "21.4.9",
    "@hapi/inert": "7.1.0",
    "@hapi/scooter": "8.0.0",
    "@hapi/vision": "7.0.3",
    "@hapi/wreck": "18.1.2",
    "@hapi/yar": "11.0.3",
    "blankie": "5.0.0",
    "convict": "6.2.5",
    "convict-format-with-validator": "6.2.0",
    "cssnano": "7.1.5",
    "cssnano-preset-default": "7.0.13",
    "date-fns": "4.1.0",
    "diff": "9.0.0",
    "govuk-frontend": "6.2.0",
    "hapi-pino": "13.0.0",
    "hapi-pulse": "3.0.0",
    "ioredis": "5.8.2",
    "lodash": "4.18.1",
    "nunjucks": "3.2.4",
    "openid-client": "6.8.2",
    "pino": "10.3.1"
  },
  "devDependencies": {
    "@babel/preset-env": "7.29.2",
    "@defra/hapi-connect": "1.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/convict": "6.1.6",
    "@types/convict-format-with-validator": "6.0.6",
    "@types/lodash": "4.17.24",
    "@types/node": "26.1.1",
    "@types/nunjucks": "3.2.6",
    "@vitest/coverage-v8": "4.1.8",
    "@vitest/eslint-plugin": "1.6.23",
    "cheerio": "1.2.0",
    "daisyui": "5.7.20",
    "eslint": "9.39.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "happy-dom": "20.11.6",
    "husky": "9.1.7",
    "neostandard": "0.13.0",
    "nodemon": "3.1.14",
    "npm-run-all": "4.1.5",
    "pino-pretty": "13.1.3",
    "prettier": "3.8.2",
    "sass-embedded": "1.99.0",
    "stylelint": "16.26.1",
    "stylelint-config-gds": "2.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.8",
    "vitest-fetch-mock": "0.4.5"
  }
}
